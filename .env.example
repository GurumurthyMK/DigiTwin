DATABASE_URL=sqlite:///./digitwin.db
JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:19006
LOG_LEVEL=INFO
# Brute-force shield (auth register/login/refresh, per IP). Disable only in tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=60
# Cookie transport: web uses httpOnly cookies. SameSite=lax + Secure=false is
# correct for same-origin serving (and the localhost dev proxy). Set
# COOKIE_SECURE=true and CORS_ORIGINS to the exact web origin in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Error tracking (Sentry). Empty = disabled. Set to enable in staging/prod.
SENTRY_DSN=
# Password-reset email delivery. Dev default (log) records metadata only and
# never logs tokens. Staging/prod MUST use email_backend=smtp + SMTP below.
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
# Public web origin embedded in password-reset links (no trailing slash).
APP_BASE_URL=http://localhost:5173
