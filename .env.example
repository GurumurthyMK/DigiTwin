DATABASE_URL=sqlite:///./digitwin.db
JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:19006
LOG_LEVEL=INFO
# Brute-force shield (auth register/login/refresh, per IP). Disable only in tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=60
# Cookie transport: web uses httpOnly cookies. SameSite=lax + Secure=false is
# correct for same-origin serving (and the localhost dev proxy). Set
# COOKIE_SECURE=true and CORS_ORIGINS to the exact web origin in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Error tracking (Sentry). Empty = disabled. Set to enable in staging/prod.
SENTRY_DSN=
